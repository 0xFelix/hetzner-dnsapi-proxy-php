{
    "name": "0xfelix/hetzner-dnsapi-proxy-php",
    "description": "PHP DNS API proxy for Hetzner Cloud, compatible with hetzner-dnsapi-proxy endpoints",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "jeremykendall/php-domain-parser": "^6.0",
        "lkdevelopment/hetzner-cloud-php-sdk": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "HetznerDnsapiProxy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HetznerDnsapiProxy\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "update-psl": "@php bin/update-psl.php",
        "update-psl-force": "@php bin/update-psl.php --force",
        "post-install-cmd": "@update-psl",
        "post-update-cmd": "@update-psl",
        "fmt": "php-cs-fixer fix",
        "fmt:check": "php-cs-fixer fix --dry-run --diff",
        "lint": [
            "@fmt:check",
            "phpstan analyse --memory-limit=512M"
        ],
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "update-psl": "Download the public suffix list if the local copy is missing or stale",
        "update-psl-force": "Re-download the public suffix list regardless of age",
        "fmt": "Apply code style fixes",
        "fmt:check": "Report code style violations without changing files",
        "lint": "Check code style and run static analysis",
        "test": "Run the test suite"
    }
}
